# Comma-separated GPU UUIDs from `nvidia-smi -L`.
GPU_DEVICES=GPU-REPLACE-FIRST,GPU-REPLACE-SECOND

MODEL_DIR=/opt/models/qwen38-flashnext-fp6int8
IMAGE=sglang-fp6:sm80-fix1
NAME=qwen38-flashnext-fp6
PORT=18020

CTX=262144
MEM=0.93
CHUNKED_PREFILL=4096
MAX_RUNNING_REQUESTS=3
MAMBA_SLOTS=24
MAMBA_DTYPE=float16

SPEC_ALGO=NEXTN
SPEC_STEPS=1
SPEC_TOPK=1
SPEC_DRAFT=2
GRAPH_DECODE=full
